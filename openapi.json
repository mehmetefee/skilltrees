{
  "openapi": "3.0.3",
  "info": {
    "title": "Skill Trees API",
    "description": "Backend API for a public skill-tree sharing site. Reading is public and needs no account; creating or changing a tree requires a session, and a tree may only be modified by the account that created it. Zero external dependencies: node:http and node:sqlite only. Errors are RFC 9457 problem details (application/problem+json) that keep the older `error` (and, for rejected imports, `problems`) members. Every GET also answers HEAD. A known path asked with a method it doesn't take answers 405 with an Allow header (components/responses/MethodNotAllowed), and OPTIONS answers Allow with no CORS headers: cross-origin use is unsupported. A request body must be declared application/json, or it is refused with 415. Cross-site requests are refused with 403 unless they are top-level GET navigations (W3C Fetch Metadata), as are state-changing requests whose Origin is another host. Responses are compressed (br, gzip) when the client accepts it, and GETs carry an ETag and answer If-None-Match with 304.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:3001",
      "description": "Local development server"
    }
  ],
  "tags": [
    { "name": "Auth", "description": "Accounts and sessions" },
    { "name": "Trees", "description": "Skill trees" },
    { "name": "Skills", "description": "Individual skills inside a tree" },
    { "name": "Prerequisites", "description": "Directed links between skills" },
    { "name": "Import Export", "description": "The portable JSON tree format" },
    { "name": "Reports", "description": "Browser security reports (CSP violations)" }
  ],
  "paths": {
    "/api/auth/signup": {
      "post": {
        "operationId": "signup",
        "summary": "Create an account",
        "tags": ["Auth"],
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/Credentials" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Account created; a session cookie is set",
            "headers": { "Set-Cookie": { "$ref": "#/components/headers/SetSessionCookie" } },
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/User" } }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "413": { "$ref": "#/components/responses/PayloadTooLarge" },
          "415": { "$ref": "#/components/responses/UnsupportedMediaType" },
          "429": { "$ref": "#/components/responses/TooManyRequests" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "operationId": "login",
        "summary": "Sign in",
        "tags": ["Auth"],
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/Credentials" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Signed in; a session cookie is set",
            "headers": { "Set-Cookie": { "$ref": "#/components/headers/SetSessionCookie" } },
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/User" } }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "413": { "$ref": "#/components/responses/PayloadTooLarge" },
          "415": { "$ref": "#/components/responses/UnsupportedMediaType" },
          "429": { "$ref": "#/components/responses/TooManyRequests" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "operationId": "logout",
        "summary": "Sign out and invalidate the session",
        "tags": ["Auth"],
        "security": [{ "SessionCookie": [] }],
        "responses": {
          "200": {
            "description": "Signed out; the session cookie is cleared",
            "headers": { "Set-Cookie": { "$ref": "#/components/headers/SetSessionCookie" } },
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Ok" } }
            }
          },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "operationId": "getCurrentUser",
        "summary": "The signed-in account, or null",
        "tags": ["Auth"],
        "security": [{ "SessionCookie": [] }, {}],
        "responses": {
          "200": {
            "description": "The current account, or null when signed out",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["user"],
                  "properties": {
                    "user": {
                      "nullable": true,
                      "allOf": [{ "$ref": "#/components/schemas/User" }]
                    }
                  }
                }
              }
            }
          },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/api/trees": {
      "get": {
        "operationId": "listTrees",
        "summary": "All public trees, newest first",
        "tags": ["Trees"],
        "security": [],
        "responses": {
          "200": {
            "description": "Every tree, with its skill count",
            "headers": { "ETag": { "$ref": "#/components/headers/ETag" } },
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "maxItems": 10000,
                  "items": { "$ref": "#/components/schemas/TreeSummary" }
                }
              }
            }
          },
          "304": { "$ref": "#/components/responses/NotModified" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      },
      "post": {
        "operationId": "createTree",
        "summary": "Create a tree owned by the signed-in account",
        "tags": ["Trees"],
        "security": [{ "SessionCookie": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/TreeCreate" } }
          }
        },
        "responses": {
          "201": {
            "description": "The created tree",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Tree" } }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "413": { "$ref": "#/components/responses/PayloadTooLarge" },
          "415": { "$ref": "#/components/responses/UnsupportedMediaType" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/api/trees/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/TreeId" }],
      "get": {
        "operationId": "getTree",
        "summary": "One tree with its skills and prerequisite links",
        "tags": ["Trees"],
        "security": [],
        "responses": {
          "200": {
            "description": "The tree, its skills and its links",
            "headers": { "ETag": { "$ref": "#/components/headers/ETag" } },
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/TreeDetail" } }
            }
          },
          "304": { "$ref": "#/components/responses/NotModified" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      },
      "patch": {
        "operationId": "updateTree",
        "summary": "Change a tree's title, description or author",
        "description": "Only the account that owns the tree may do this. Trees created before accounts existed have no owner and are read-only for everyone.",
        "tags": ["Trees"],
        "security": [{ "SessionCookie": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/TreeUpdate" } }
          }
        },
        "responses": {
          "200": {
            "description": "The updated tree",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Tree" } }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "413": { "$ref": "#/components/responses/PayloadTooLarge" },
          "415": { "$ref": "#/components/responses/UnsupportedMediaType" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      },
      "delete": {
        "operationId": "deleteTree",
        "summary": "Delete a tree and everything in it",
        "tags": ["Trees"],
        "security": [{ "SessionCookie": [] }],
        "responses": {
          "200": {
            "description": "Deleted",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Ok" } }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/api/trees/{id}/skills": {
      "parameters": [{ "$ref": "#/components/parameters/TreeId" }],
      "post": {
        "operationId": "createSkill",
        "summary": "Add a skill to a tree",
        "tags": ["Skills"],
        "security": [{ "SessionCookie": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/SkillCreate" } }
          }
        },
        "responses": {
          "201": {
            "description": "The created skill",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Skill" } }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "413": { "$ref": "#/components/responses/PayloadTooLarge" },
          "415": { "$ref": "#/components/responses/UnsupportedMediaType" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/api/skills/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/SkillId" }],
      "patch": {
        "operationId": "updateSkill",
        "summary": "Rename or reposition a skill",
        "tags": ["Skills"],
        "security": [{ "SessionCookie": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/SkillUpdate" } }
          }
        },
        "responses": {
          "200": {
            "description": "The updated skill",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Skill" } }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "413": { "$ref": "#/components/responses/PayloadTooLarge" },
          "415": { "$ref": "#/components/responses/UnsupportedMediaType" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      },
      "delete": {
        "operationId": "deleteSkill",
        "summary": "Delete a skill and its links",
        "tags": ["Skills"],
        "security": [{ "SessionCookie": [] }],
        "responses": {
          "200": {
            "description": "Deleted",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Ok" } }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/api/trees/{id}/prereqs": {
      "parameters": [{ "$ref": "#/components/parameters/TreeId" }],
      "post": {
        "operationId": "createPrereq",
        "summary": "Link one skill as a prerequisite of another",
        "description": "Both skills must belong to this tree, and the link must not create a cycle.",
        "tags": ["Prerequisites"],
        "security": [{ "SessionCookie": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/PrereqCreate" } }
          }
        },
        "responses": {
          "201": {
            "description": "The created link",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Edge" } }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "413": { "$ref": "#/components/responses/PayloadTooLarge" },
          "415": { "$ref": "#/components/responses/UnsupportedMediaType" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/api/prereqs/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/PrereqId" }],
      "delete": {
        "operationId": "deletePrereq",
        "summary": "Remove a prerequisite link",
        "tags": ["Prerequisites"],
        "security": [{ "SessionCookie": [] }],
        "responses": {
          "200": {
            "description": "Deleted",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Ok" } }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/api/trees/{id}/export": {
      "parameters": [{ "$ref": "#/components/parameters/TreeId" }],
      "get": {
        "operationId": "exportTree",
        "summary": "Download a tree in the portable format",
        "tags": ["Import Export"],
        "security": [],
        "parameters": [
          {
            "name": "layout",
            "in": "query",
            "required": false,
            "description": "Override the tree's own layout mode.",
            "schema": { "$ref": "#/components/schemas/LayoutMode" }
          }
        ],
        "responses": {
          "200": {
            "description": "The tree as a portable JSON document",
            "headers": {
              "Content-Disposition": {
                "description": "Attachment filename derived from the tree title.",
                "schema": { "type": "string", "maxLength": 300 }
              },
              "ETag": { "$ref": "#/components/headers/ETag" }
            },
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Notation" } }
            }
          },
          "304": { "$ref": "#/components/responses/NotModified" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      },
      "post": {
        "operationId": "exportTreeWithPositions",
        "summary": "Download a tree, supplying on-screen coordinates",
        "description": "Dragging a skill is session-only and never saved, so the browser sends its current arrangement with the request when exporting as manual.",
        "tags": ["Import Export"],
        "security": [],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/ExportRequest" } }
          }
        },
        "responses": {
          "200": {
            "description": "The tree as a portable JSON document",
            "headers": {
              "Content-Disposition": {
                "description": "Attachment filename derived from the tree title.",
                "schema": { "type": "string", "maxLength": 300 }
              }
            },
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Notation" } }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "413": { "$ref": "#/components/responses/PayloadTooLarge" },
          "415": { "$ref": "#/components/responses/UnsupportedMediaType" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/api/trees/import": {
      "post": {
        "operationId": "importTree",
        "summary": "Create a tree from a portable JSON document",
        "tags": ["Import Export"],
        "security": [{ "SessionCookie": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/Notation" } }
          }
        },
        "responses": {
          "201": {
            "description": "The imported tree",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Tree" } }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationProblems" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "413": { "$ref": "#/components/responses/PayloadTooLarge" },
          "415": { "$ref": "#/components/responses/UnsupportedMediaType" },
          "429": { "$ref": "#/components/responses/TooManyRequests" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/api/reports": {
      "post": {
        "operationId": "receiveReports",
        "summary": "Receive CSP violation reports from browsers",
        "description": "The endpoint pages name in Reporting-Endpoints (csp-endpoint) and in their CSP's report-to and report-uri. Takes the Reporting API's application/reports+json (an array of reports) and CSP2's application/csp-report (one report). Bodies are capped at 64 KB; the endpoint is throttled per address (10 per 15 minutes). Each report is logged as one line, with query strings removed from its URLs; nothing is stored.",
        "tags": ["Reports"],
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/reports+json": { "schema": { "$ref": "#/components/schemas/ReportList" } },
            "application/csp-report": { "schema": { "$ref": "#/components/schemas/CspReport" } }
          }
        },
        "responses": {
          "204": { "description": "Received" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "413": { "$ref": "#/components/responses/PayloadTooLarge" },
          "415": { "$ref": "#/components/responses/UnsupportedMediaType" },
          "429": { "$ref": "#/components/responses/TooManyRequests" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "SessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "skilltree_session",
        "description": "Opaque 256-bit session token. HttpOnly, SameSite=Lax, and Secure when served over HTTPS."
      }
    },
    "headers": {
      "SetSessionCookie": {
        "description": "Sets or clears the session cookie.",
        "schema": { "type": "string", "maxLength": 500 }
      },
      "ETag": {
        "description": "Strong validator for this representation (RFC 9110 §8.8.3), distinct per Content-Encoding. Send it back in If-None-Match to get a 304 when nothing changed.",
        "schema": { "type": "string", "maxLength": 100 }
      },
      "Allow": {
        "description": "The methods this path takes (RFC 9110 §10.2.1).",
        "schema": { "type": "string", "maxLength": 100, "example": "GET, HEAD, POST, OPTIONS" }
      },
      "Accept": {
        "description": "The request media types this operation takes (RFC 9110 §15.5.16).",
        "schema": { "type": "string", "maxLength": 200, "example": "application/json" }
      },
      "RetryAfter": {
        "description": "Seconds to wait before trying again (RFC 9110 §10.2.3).",
        "schema": { "type": "integer", "minimum": 0, "maximum": 86400, "example": 900 }
      },
      "RateLimitPolicy": {
        "description": "The quota policy that was hit, as an Internet-Draft structured field (draft-ietf-httpapi-ratelimit-headers-11): q is the quota, w the window in seconds. Advisory until the draft is published.",
        "schema": { "type": "string", "maxLength": 200, "example": "\"attempts\";q=10;w=900" }
      },
      "RateLimit": {
        "description": "Remaining quota (r) and seconds until it is restored (t), per the same draft.",
        "schema": { "type": "string", "maxLength": 200, "example": "\"attempts\";r=0;t=900" }
      }
    },
    "parameters": {
      "TreeId": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "Tree id.",
        "schema": { "type": "integer", "format": "int64", "minimum": 1, "maximum": 9007199254740991 }
      },
      "SkillId": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "Skill id.",
        "schema": { "type": "integer", "format": "int64", "minimum": 1, "maximum": 9007199254740991 }
      },
      "PrereqId": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "Prerequisite link id.",
        "schema": { "type": "integer", "format": "int64", "minimum": 1, "maximum": 9007199254740991 }
      }
    },
    "responses": {
      "NotModified": {
        "description": "The If-None-Match validator still matches; use the stored copy"
      },
      "BadRequest": {
        "description": "The request was malformed or failed validation",
        "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "Unauthorized": {
        "description": "Not signed in, or the credentials were wrong",
        "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "Forbidden": {
        "description": "Signed in, but this is not your tree (or it has no owner and is read-only); or a cross-site request (Fetch Metadata, or an Origin that isn't this host)",
        "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "NotFound": {
        "description": "No such resource",
        "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "Conflict": {
        "description": "Already exists",
        "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "MethodNotAllowed": {
        "description": "The path exists but doesn't take this method. Not listed per operation, since it answers the methods that aren't there.",
        "headers": { "Allow": { "$ref": "#/components/headers/Allow" } },
        "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "UnsupportedMediaType": {
        "description": "The request body wasn't declared as a type this operation takes (application/json unless stated), wasn't UTF-8, or was content-encoded",
        "headers": { "Accept": { "$ref": "#/components/headers/Accept" } },
        "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "PayloadTooLarge": {
        "description": "Request body exceeded 1 MB",
        "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "TooManyRequests": {
        "description": "Too many attempts; throttled",
        "headers": {
          "Retry-After": { "$ref": "#/components/headers/RetryAfter" },
          "RateLimit-Policy": { "$ref": "#/components/headers/RateLimitPolicy" },
          "RateLimit": { "$ref": "#/components/headers/RateLimit" }
        },
        "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "ValidationProblems": {
        "description": "The document was rejected, with a list of reasons",
        "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/ValidationError" } } }
      },
      "ServerError": {
        "description": "Unexpected server error",
        "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      }
    },
    "schemas": {
      "Ok": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ok"],
        "properties": { "ok": { "type": "boolean" } }
      },
      "Error": {
        "description": "An RFC 9457 problem details object. type is about:blank, so title is the HTTP status phrase; detail says what went wrong. error repeats detail for clients written before problem details.",
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "title", "status", "detail", "error"],
        "properties": {
          "type": { "type": "string", "format": "uri-reference", "maxLength": 300, "example": "about:blank" },
          "title": { "type": "string", "maxLength": 100, "example": "Not Found" },
          "status": { "type": "integer", "format": "int32", "minimum": 400, "maximum": 599, "example": 404 },
          "detail": { "type": "string", "maxLength": 300, "example": "Tree not found" },
          "error": { "type": "string", "maxLength": 300, "example": "Tree not found" }
        }
      },
      "ValidationError": {
        "description": "A problem details object (see Error) that also lists each reason the document was rejected.",
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "title", "status", "detail", "error"],
        "properties": {
          "type": { "type": "string", "format": "uri-reference", "maxLength": 300, "example": "about:blank" },
          "title": { "type": "string", "maxLength": 100, "example": "Bad Request" },
          "status": { "type": "integer", "format": "int32", "minimum": 400, "maximum": 599, "example": 400 },
          "detail": { "type": "string", "maxLength": 300 },
          "error": { "type": "string", "maxLength": 300 },
          "problems": {
            "type": "array",
            "maxItems": 500,
            "items": { "type": "string", "maxLength": 500 }
          }
        }
      },
      "ReportList": {
        "description": "A Reporting API upload (W3C Reporting API): a list of reports. Only type and body are read.",
        "type": "array",
        "maxItems": 100,
        "items": {
          "type": "object",
          "properties": {
            "type": { "type": "string", "maxLength": 100, "example": "csp-violation" },
            "age": { "type": "integer", "format": "int64", "minimum": 0, "maximum": 9007199254740991 },
            "url": { "type": "string", "maxLength": 2048 },
            "user_agent": { "type": "string", "maxLength": 1000 },
            "body": {
              "type": "object",
              "properties": {
                "documentURL": { "type": "string", "maxLength": 2048 },
                "blockedURL": { "type": "string", "maxLength": 2048 },
                "effectiveDirective": { "type": "string", "maxLength": 100 },
                "disposition": { "type": "string", "enum": ["enforce", "report"] }
              }
            }
          }
        }
      },
      "CspReport": {
        "description": "A CSP Level 2 report-uri body.",
        "type": "object",
        "required": ["csp-report"],
        "properties": {
          "csp-report": {
            "type": "object",
            "properties": {
              "document-uri": { "type": "string", "maxLength": 2048 },
              "blocked-uri": { "type": "string", "maxLength": 2048 },
              "violated-directive": { "type": "string", "maxLength": 100 },
              "effective-directive": { "type": "string", "maxLength": 100 },
              "disposition": { "type": "string", "enum": ["enforce", "report"] }
            }
          }
        }
      },
      "Credentials": {
        "type": "object",
        "additionalProperties": false,
        "required": ["username", "password"],
        "properties": {
          "username": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{3,40}$",
            "minLength": 3,
            "maxLength": 40,
            "example": "ada"
          },
          "password": {
            "type": "string",
            "format": "password",
            "minLength": 8,
            "maxLength": 4096,
            "example": "a-long-enough-passphrase"
          }
        }
      },
      "User": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "username"],
        "properties": {
          "id": { "type": "integer", "format": "int64", "minimum": 1, "maximum": 9007199254740991, "readOnly": true },
          "username": { "type": "string", "pattern": "^[a-zA-Z0-9_-]{3,40}$", "minLength": 3, "maxLength": 40 }
        }
      },
      "LayoutMode": {
        "type": "string",
        "enum": ["manual", "auto"],
        "description": "manual: stored coordinates are authoritative. auto: coordinates are ignored and the layout is computed from structure."
      },
      "Timestamp": {
        "type": "string",
        "description": "SQLite datetime('now') output in UTC: 'YYYY-MM-DD HH:MM:SS'. Note this is not RFC 3339 (no 'T' separator, no offset).",
        "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}$",
        "minLength": 19,
        "maxLength": 19,
        "example": "2026-09-19 07:58:31"
      },
      "Tree": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "description", "author", "layout", "featured", "created_at"],
        "properties": {
          "id": { "type": "integer", "format": "int64", "minimum": 1, "maximum": 9007199254740991, "readOnly": true },
          "title": { "type": "string", "minLength": 1, "maxLength": 120 },
          "description": { "type": "string", "maxLength": 1000 },
          "author": { "type": "string", "maxLength": 80 },
          "layout": { "$ref": "#/components/schemas/LayoutMode" },
          "featured": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1,
            "readOnly": true,
            "description": "1 for the homepage spotlight. Set server-side only; ignored if supplied in a request."
          },
          "user_id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "maximum": 9007199254740991,
            "nullable": true,
            "readOnly": true,
            "description": "Owning account. null means the tree predates accounts and is read-only for everyone."
          },
          "created_at": { "allOf": [{ "$ref": "#/components/schemas/Timestamp" }], "readOnly": true }
        }
      },
      "TreeSummary": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "description", "author", "created_at", "featured", "skill_count"],
        "properties": {
          "id": { "type": "integer", "format": "int64", "minimum": 1, "maximum": 9007199254740991 },
          "title": { "type": "string", "minLength": 1, "maxLength": 120 },
          "description": { "type": "string", "maxLength": 1000 },
          "author": { "type": "string", "maxLength": 80 },
          "created_at": { "$ref": "#/components/schemas/Timestamp" },
          "featured": { "type": "integer", "minimum": 0, "maximum": 1 },
          "user_id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "maximum": 9007199254740991,
            "nullable": true
          },
          "skill_count": { "type": "integer", "format": "int32", "minimum": 0, "maximum": 100000 }
        }
      },
      "TreeDetail": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "description", "author", "layout", "featured", "created_at", "skills", "edges"],
        "properties": {
          "id": { "type": "integer", "format": "int64", "minimum": 1, "maximum": 9007199254740991 },
          "title": { "type": "string", "minLength": 1, "maxLength": 120 },
          "description": { "type": "string", "maxLength": 1000 },
          "author": { "type": "string", "maxLength": 80 },
          "layout": { "$ref": "#/components/schemas/LayoutMode" },
          "featured": { "type": "integer", "minimum": 0, "maximum": 1 },
          "user_id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "maximum": 9007199254740991,
            "nullable": true
          },
          "created_at": { "$ref": "#/components/schemas/Timestamp" },
          "skills": {
            "type": "array",
            "maxItems": 10000,
            "items": { "$ref": "#/components/schemas/Skill" }
          },
          "edges": {
            "type": "array",
            "maxItems": 100000,
            "items": { "$ref": "#/components/schemas/Edge" }
          }
        }
      },
      "TreeCreate": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title"],
        "properties": {
          "title": { "type": "string", "minLength": 1, "maxLength": 120, "example": "Home Bread Baking" },
          "description": { "type": "string", "maxLength": 1000 },
          "author": { "type": "string", "maxLength": 80 }
        }
      },
      "TreeUpdate": {
        "type": "object",
        "additionalProperties": false,
        "minProperties": 1,
        "properties": {
          "title": { "type": "string", "minLength": 1, "maxLength": 120 },
          "description": { "type": "string", "maxLength": 1000 },
          "author": { "type": "string", "maxLength": 80 }
        }
      },
      "Skill": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "tree_id", "name", "description", "pos_x", "pos_y", "created_at"],
        "properties": {
          "id": { "type": "integer", "format": "int64", "minimum": 1, "maximum": 9007199254740991, "readOnly": true },
          "tree_id": { "type": "integer", "format": "int64", "minimum": 1, "maximum": 9007199254740991, "readOnly": true },
          "name": { "type": "string", "minLength": 1, "maxLength": 120 },
          "description": { "type": "string", "maxLength": 1000 },
          "pos_x": { "type": "number", "format": "double", "minimum": -1000000, "maximum": 1000000 },
          "pos_y": { "type": "number", "format": "double", "minimum": -1000000, "maximum": 1000000 },
          "created_at": { "allOf": [{ "$ref": "#/components/schemas/Timestamp" }], "readOnly": true }
        }
      },
      "SkillCreate": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 120, "example": "Knead dough" },
          "description": { "type": "string", "maxLength": 1000 },
          "pos_x": { "type": "number", "format": "double", "minimum": -1000000, "maximum": 1000000 },
          "pos_y": { "type": "number", "format": "double", "minimum": -1000000, "maximum": 1000000 }
        }
      },
      "SkillUpdate": {
        "type": "object",
        "additionalProperties": false,
        "minProperties": 1,
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 120 },
          "description": { "type": "string", "maxLength": 1000 },
          "pos_x": { "type": "number", "format": "double", "minimum": -1000000, "maximum": 1000000 },
          "pos_y": { "type": "number", "format": "double", "minimum": -1000000, "maximum": 1000000 }
        }
      },
      "Edge": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "skill_id", "prereq_skill_id"],
        "properties": {
          "id": { "type": "integer", "format": "int64", "minimum": 1, "maximum": 9007199254740991, "readOnly": true },
          "skill_id": { "type": "integer", "format": "int64", "minimum": 1, "maximum": 9007199254740991 },
          "prereq_skill_id": { "type": "integer", "format": "int64", "minimum": 1, "maximum": 9007199254740991 }
        }
      },
      "PrereqCreate": {
        "type": "object",
        "additionalProperties": false,
        "required": ["skill_id", "prereq_skill_id"],
        "properties": {
          "skill_id": { "type": "integer", "format": "int64", "minimum": 1, "maximum": 9007199254740991 },
          "prereq_skill_id": { "type": "integer", "format": "int64", "minimum": 1, "maximum": 9007199254740991 }
        }
      },
      "Position": {
        "type": "object",
        "additionalProperties": false,
        "required": ["x", "y"],
        "properties": {
          "x": { "type": "number", "format": "double", "minimum": -1000000, "maximum": 1000000 },
          "y": { "type": "number", "format": "double", "minimum": -1000000, "maximum": 1000000 }
        }
      },
      "ExportRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "layout": { "$ref": "#/components/schemas/LayoutMode" },
          "positions": {
            "type": "object",
            "nullable": true,
            "description": "Map of skill id to on-screen coordinates.",
            "additionalProperties": { "$ref": "#/components/schemas/Position" }
          }
        }
      },
      "NotationSkill": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Slug, unique within the document. Skills reference each other by slug, never by database id.",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "minLength": 1,
            "maxLength": 120,
            "example": "knead-dough"
          },
          "name": { "type": "string", "minLength": 1, "maxLength": 120 },
          "description": { "type": "string", "maxLength": 1000 },
          "requires": {
            "type": "array",
            "maxItems": 1000,
            "description": "Slugs of the skills required before this one. All are required together.",
            "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "minLength": 1, "maxLength": 120 }
          },
          "position": { "$ref": "#/components/schemas/Position" }
        }
      },
      "Notation": {
        "type": "object",
        "additionalProperties": false,
        "description": "The portable tree format described in FORMAT.md.",
        "required": ["format", "version", "title", "skills"],
        "properties": {
          "format": { "type": "string", "enum": ["skilltree"] },
          "version": { "type": "integer", "format": "int32", "minimum": 1, "maximum": 1 },
          "title": { "type": "string", "minLength": 1, "maxLength": 120 },
          "description": { "type": "string", "maxLength": 1000 },
          "author": { "type": "string", "maxLength": 80 },
          "layout": { "$ref": "#/components/schemas/LayoutMode" },
          "skills": {
            "type": "array",
            "maxItems": 10000,
            "items": { "$ref": "#/components/schemas/NotationSkill" }
          }
        }
      }
    }
  }
}
